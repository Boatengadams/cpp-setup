# Windows batch files must keep CRLF endings: cmd.exe mis-parses goto/label
# blocks when the file only has LF.
*.bat text eol=crlf
*.cmd text eol=crlf
# Shell and Python sources stay LF.
*.sh  text eol=lf
cpp.py text eol=lf
lib/*.py text eol=lf
tests/*.py text eol=lf
*.md   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
LICENSE         text eol=lf

# Demo video is far too big for ordinary git objects; store it in Git LFS
# (clone with `git lfs install` to fetch the mp4s, or skip them with
# GIT_LFS_SKIP_SMUDGE=1 and they stay as small pointer files).
*.mp4 filter=lfs diff=lfs merge=lfs -text
